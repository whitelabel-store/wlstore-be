# =============================================================================
# Variáveis LOCAIS do backend (sua máquina).
#
#   cp .env.example .env        o .env nunca vai para o Git (.gitignore) nem
#                               para a imagem Docker (.dockerignore)
#
# Lido por:
#   - docker compose            sobe Postgres e RabbitMQ com estes valores
#   - serviços Spring (perfil local, o padrão)   conectam com os mesmos valores
#
# develop e prod NÃO usam este arquivo: lá as variáveis vêm do Kubernetes
# (values do repo de infra + Secrets gerados pela plataforma). Tabela completa:
# README.md → "Variáveis de ambiente".
#
# Formato: CHAVE=valor, sem aspas e sem espaços em volta do "=" (o Spring lê
# este arquivo como .properties).
# =============================================================================

# --- catalog-service (porta 8081) → Postgres catalog-db ----------------------
CATALOG_DB_PORT=5532
CATALOG_POSTGRES_DB=catalogdb
CATALOG_POSTGRES_USER=admin
CATALOG_POSTGRES_PASSWORD=admin

# --- pricing-service (porta 8082) → Postgres pricing-db ----------------------
PRICING_DB_PORT=5832
PRICING_POSTGRES_DB=pricingdb
PRICING_POSTGRES_USER=admin
PRICING_POSTGRES_PASSWORD=admin

# --- RabbitMQ (eventos catalog ↔ pricing) ------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672       # painel: http://localhost:15672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin

# --- Serviços em construção (docker compose --profile order|inventory up -d) --
ORDER_DB_PORT=5632
ORDER_POSTGRES_DB=orderdb
ORDER_POSTGRES_USER=admin
ORDER_POSTGRES_PASSWORD=admin

INVENTORY_DB_PORT=5732
INVENTORY_POSTGRES_DB=inventorydb
INVENTORY_POSTGRES_USER=admin
INVENTORY_POSTGRES_PASSWORD=admin

# Eureka (discovery-server, porta 8761): só local, usado pelo order-service.
# EUREKA_URL=http://localhost:8761/eureka/

# --- Opcional: escolher outro perfil ao rodar localmente ---------------------
# Exporte no shell (não funciona dentro deste arquivo):
#   SPRING_PROFILES_ACTIVE=prod mvn -pl catalog-service spring-boot:run
